{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^(req|res|next)$" }],
    "no-console": "off"
  },
  "ignorePatterns": ["node_modules", "dist", "compiled", "dll", "legacy", "src"],
  "overrides": [
    {
      "files": ["e2e/**/*.js"],
      "env": { "browser": true, "node": true }
    }
  ]
}
