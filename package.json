{
  "name": "cognimap",
  "version": "0.9.1",
  "description": "Browser-based cognitive mapping tool for creating, editing, and quizzing interactive concept maps offline, served by a lightweight local backend.",
  "keywords": [
    "cognitive mapping",
    "concept maps",
    "Angular",
    "offline",
    "spaced repetition",
    "quiz",
    "SVG",
    "multimedia",
    "cross-platform"
  ],
  "author": "Patrick Kaiser",
  "homepage": "https://github.com/PMK89/CogniMap",
  "license": "MIT",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "node server/index.js",
    "dev:web": "webpack serve --config config/webpack.dev.js",
    "build": "webpack --config config/webpack.prod.js --progress --bail",
    "build:dev": "webpack --config config/webpack.dev.js --progress",
    "build:prod": "npm run build",
    "preview": "npm run build && npm start",
    "test": "npm run lint && npm run typecheck && npm run test:backend",
    "test:backend": "node --test server/test/*.test.js",
    "test:unit": "node --test server/test/graph3d.test.js",
    "test:integration": "node --test server/test/cme.test.js server/test/config.test.js server/test/media.test.js server/test/quiz.test.js",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/graph3d.spec.js",
    "benchmark:3d": "node scripts/benchmark3d.js",
    "migrate:dry-run": "node scripts/migrate3d-dry-run.js",
    "verify": "npm run test && npm run build && npm run test:e2e",
    "lint": "eslint server e2e",
    "typecheck": "tsc --noEmit --skipLibCheck --types node --lib es2015,dom --target es5 --module commonjs --moduleResolution node --experimentalDecorators src/app/shared/backend.service.ts src/app/widgets/widget-registry.ts src/app/widgets/widget-iframe.adapter.ts",
    "clean:dist": "rimraf dist",
    "watch": "webpack --config config/webpack.dev.js --watch"
  },
